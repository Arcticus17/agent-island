    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
